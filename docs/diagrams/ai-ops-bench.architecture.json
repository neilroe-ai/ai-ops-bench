  "cards": [
    {
      "dot": "cyan",
      "title": "Three money types, never mixed",
      "items": [
        "cash spends cost_usd under monthly and per-lane ceilings",
        "free NVIDIA lanes cost nothing and price shadow_cost_usd for reporting",
        "promotional credit spends credit_usd under lifetime and expiry limits"
      ]
    },
    {
      "dot": "amber",
      "title": "Order of one run",
      "items": [
        "breaker, window, invariant, estimate, authorize, call, log",
        "the session ceiling alerts and pauses; non-interactive runs stop",
        "a throttled free lane falls back to its paid shadow_of lane"
      ]
    },
    {
      "dot": "rose",
      "title": "What the harness refuses to decide",
      "items": [
        "Only the CSV promotes a lane; a new model enters as a row",
        "Claude Pro is never a lane and never authenticates here",
        "Neil logs the choice in docs/model-decisions.md"
      ]
    }
  ]
